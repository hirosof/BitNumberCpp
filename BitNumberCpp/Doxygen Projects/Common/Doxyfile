RTF_EXTRA_FILES        =

#---------------------------------------------------------------------------
# manページ出力に関連する設定オプション
#---------------------------------------------------------------------------

# GENERATE_MAN タグが YES に設定されている場合、Doxygenはクラスとファイルのマニュアルページを生成します。
# デフォルト値は NO です。

GENERATE_MAN           = NO

# MAN_OUTPUT
# タグは、マニュアルページが配置される場所を指定するために使用されます。相対パスが入力された場合、OUTPUT_DIRECTORYの値がその前に配置されます。
# man 3ディレクトリが MAN_OUTPUT で指定されたディレクトリ内に作成されます。
