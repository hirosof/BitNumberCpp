# このタグはタグ GENERATE_RTF を YES に設定する必要があります。

RTF_OUTPUT             = rtf

# COMPACT_RTF タグが YES
# に設定されている場合、DoxygenはよりコンパクトなRTFドキュメントを生成します。これは小さなプロジェクトに役立ち、一般的に紙の節約にもなります。
