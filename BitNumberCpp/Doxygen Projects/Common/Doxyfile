# HTMLヘルプワークショップには、Doxygenによって生成されたすべてのHTML出力を単一のコンパイル済みHTMLファイル（
# .chm）に変換できるコンパイラが含まれています。コンパイル済みHTMLファイルは現在Windows
# 98ヘルプ形式として使用されており、将来すべてのWindowsプラットフォームで古いWindowsヘルプ形式（ .hlp）に取って代わります。圧縮HTMLフ
# ァイルにはインデックスと目次も含まれており、ドキュメント内の単語を検索できます。HTMLワークショップには、圧縮HTMLファイルのビューアも含まれています。
# デフォルト値は NO です。
# このタグはタグ GENERATE_HTML を YES に設定する必要があります。

GENERATE_HTMLHELP      = NO

# CHM_FILE タグを使用して、結果の
# .chmファイルのファイル名を指定できます。結果をHTML出力ディレクトリに書き込まない場合は、ファイルの前にパスを追加できます。
# このタグはタグ GENERATE_HTMLHELP を YES に設定する必要があります。

CHM_FILE               =

# HHC_LOCATION タグを使用して、HTMLヘルプコンパイラ（ hhc.exe
# ）の場所（ファイル名を含む絶対パス）を指定できます。空でない場合、Doxygenは生成された index.hhp
# でHTMLヘルプコンパイラを実行しようとします。
# ファイルは完全パスで指定する必要があります。
# このタグはタグ GENERATE_HTMLHELP を YES に設定する必要があります。

HHC_LOCATION           =

# GENERATE_CHI フラグは、別の .chiインデックスファイルが生成されるか（ YES ）、メインの .chmファイルに含まれるか（ NO
# ）を制御します。
# デフォルト値は NO です。
# このタグはタグ GENERATE_HTMLHELP を YES に設定する必要があります。

GENERATE_CHI           = NO

# CHM_INDEX_ENCODING は、HtmlHelpインデックス（ hhk ）、コンテンツ（ hhc
# ）、およびプロジェクトファイルのコンテンツをエンコードするために使用されます。
# このタグはタグ GENERATE_HTMLHELP を YES に設定する必要があります。

CHM_INDEX_ENCODING     =

# BINARY_TOC フラグは、 .chmファイルでバイナリ目次を生成するか（ YES ）、通常の目次を生成するか（ NO
# ）を制御します。さらに、「前へ」および「次へ」ボタンを有効にします。
# デフォルト値は NO です。
# このタグはタグ GENERATE_HTMLHELP を YES に設定する必要があります。

BINARY_TOC             = NO

# TOC_EXPAND フラグを YES に設定すると、HTMLヘルプドキュメントの目次およびツリービューにグループメンバーの追加項目が追加されます。
# デフォルト値は NO です。
# このタグはタグ GENERATE_HTMLHELP を YES に設定する必要があります。

TOC_EXPAND             = NO

# SITEMAP_URL タグは、ドキュメントのデプロイ時にユーザーが生成されたドキュメントをサーバー上のどこに配置するかを示す完全なURLを指定するために
# 使用されます。生成されるサイトマップはsitemap.xmlという名前で、HTML_OUTPUTで指定されたディレクトリに配置されます。
# SITEMAP_URL が指定されていない場合、サイトマップは生成されません。サイトマッププロトコルの詳細については、https://www.sitemap
# s.orgを参照してください。
# このタグはタグ GENERATE_HTML を YES に設定する必要があります。

SITEMAP_URL            =

# GENERATE_QHP タグが YES
# に設定され、QHP_NAMESPACEとQHP_VIRTUAL_FOLDERの両方が設定されている場合、生成されたHTMLドキュメントのQt圧縮ヘルプ（
# .qch）を生成するためにQtのqhelpgeneratorの入力として使用できる追加のインデックスファイルが生成されます。
# デフォルト値は NO です。
# このタグはタグ GENERATE_HTML を YES に設定する必要があります。

GENERATE_QHP           = NO

# QHG_LOCATIONタグが指定されている場合、 QCH_FILE タグを使用して結果の
# .qchファイルのファイル名を指定できます。指定されたパスはHTML出力フォルダーからの相対パスです。
# このタグはタグ GENERATE_QHP を YES に設定する必要があります。

QCH_FILE               =

# QHP_NAMESPACE
# タグは、Qtヘルププロジェクト出力を生成するときに使用する名前空間を指定します。詳細については、Qtヘルププロジェクト/名前空間 (see:
# https://doc.qt.io/archives/qt-4.8/qthelpproject.html#namespace)を参照してください。
# デフォルト値は org.doxygen.Project です。
# このタグはタグ GENERATE_QHP を YES に設定する必要があります。

QHP_NAMESPACE          = org.doxygen.Project

# QHP_VIRTUAL_FOLDER
# タグは、Qtヘルププロジェクト出力を生成するときに使用する仮想フォルダーを指定します。詳細については、Qtヘルププロジェクト/仮想フォルダー (see:
# https://doc.qt.io/archives/qt-4.8/qthelpproject.html#virtual-
# folders)を参照してください。
# デフォルト値は doc です。
# このタグはタグ GENERATE_QHP を YES に設定する必要があります。

QHP_VIRTUAL_FOLDER     = doc

# QHP_CUST_FILTER_NAME
# タグが設定されている場合、追加するカスタムフィルターの名前を指定します。詳細については、Qtヘルププロジェクト/カスタムフィルター (see:
# https://doc.qt.io/archives/qt-4.8/qthelpproject.html#custom-filters)を参照してください。
# このタグはタグ GENERATE_QHP を YES に設定する必要があります。

QHP_CUST_FILTER_NAME   =

# QHP_CUST_FILTER_ATTRS
# タグは、追加するカスタムフィルターの属性のリストを指定します。詳細については、Qtヘルププロジェクト/カスタムフィルター (see:
# https://doc.qt.io/archives/qt-4.8/qthelpproject.html#custom-filters)を参照してください。
# このタグはタグ GENERATE_QHP を YES に設定する必要があります。

QHP_CUST_FILTER_ATTRS  =

# QHP_SECT_FILTER_ATTRS
# タグは、このプロジェクトのフィルターセクションが一致する属性のリストを指定します。Qtヘルププロジェクト/フィルター属性 (see:
# https://doc.qt.io/archives/qt-4.8/qthelpproject.html#filter-attributes)。
# このタグはタグ GENERATE_QHP を YES に設定する必要があります。

QHP_SECT_FILTER_ATTRS  =

# QHG_LOCATION
# タグを使用して、Qtのqhelpgeneratorの場所（ファイル名を含む絶対パス）を指定できます。空でない場合、Doxygenは生成された
# .qhpファイルでqhelpgeneratorを実行しようとします。
# このタグはタグ GENERATE_QHP を YES に設定する必要があります。

QHG_LOCATION           =

# GENERATE_ECLIPSEHELP タグが YES に設定されている場合、HTMLファイルと共に追加のインデックスファイルが生成され、それらはEcl
# ipseヘルププラグインを形成します。このプラグインをインストールし、Eclipseのヘルプコンテンツメニューの下で使用できるようにするには、HTMLおよび
# XMLファイルを含むディレクトリの内容をeclipseのプラグインディレクトリにコピーする必要があります。プラグインディレクトリ内のディレクトリの名前は、E
# CLIPSE_DOC_ID値と同じである必要があります。コピー後、ヘルプが表示される前にEclipseを再起動する必要があります。
# デフォルト値は NO です。
# このタグはタグ GENERATE_HTML を YES に設定する必要があります。

GENERATE_ECLIPSEHELP   = NO

# Eclipseヘルププラグインの一意の識別子です。プラグインをインストールする際、HTMLおよびXMLファイルを含むディレクトリ名もこの名前にする必要があり
# ます。各ドキュメントセットには独自の識別子が必要です。
# デフォルト値は org.doxygen.Project です。
# このタグはタグ GENERATE_ECLIPSEHELP を YES に設定する必要があります。

ECLIPSE_DOC_ID         = org.doxygen.Project

# 生成されたHTMLページのレイアウトを完全に制御したい場合は、インデックスを無効にして独自のものに置き換える必要がある場合があります。
# DISABLE_INDEX タグを使用して、各HTMLページの上部にある圧縮インデックス（タブ）をオン/オフできます。 NO の値はインデックスを有効にし、
# YES の値は無効にします。インデックスのタブにはナビゲーションツリーと同じ情報が含まれているため、GENERATE_TREEVIEWも YES
# に設定している場合は、このオプションを YES に設定できます。
# デフォルト値は NO です。
# このタグはタグ GENERATE_HTML を YES に設定する必要があります。

DISABLE_INDEX          = NO

# GENERATE_TREEVIEW タグは、階層情報を表示するためのツリー状インデックス構造を生成するかどうかを指定するために使用されます。タグ値が
# YES に設定されている場合、ツリー状インデックス構造を含むサイドパネルが生成されます（HTMLヘルプ用に生成されるものと同様）。これが機能するには、Jav
# aScript、DHTML、CSS、フレームをサポートするブラウザが必要です（つまり、最新のブラウザ）。WindowsユーザーはHTMLヘルプ機能を使用した
# 方が良いでしょう。カスタムスタイルシート（HTML_EXTRA_STYLESHEETを参照）を使用すると、インデックスの外観をさらに微調整できます（"Fin
# e-tuning the output" を参照）。例として、Doxygenが生成するデフォルトのスタイルシートには、PROJECT_NAMEの代わりにツリ
# ーのルートに画像を配置する方法を示す例があります。ツリーは基本的にタブインデックスよりも詳細な情報を持っているため、このオプションを有効にする際にDISAB
# LE_INDEXを YES に設定することを検討できます。
# デフォルト値は YES です。
# このタグはタグ GENERATE_HTML を YES に設定する必要があります。

GENERATE_TREEVIEW      = YES

# GENERATE_TREEVIEWが YES に設定されている場合、 PAGE_OUTLINE_PANEL オプションは画面の右側に追加のナビゲーションパネ
# ルを表示するかどうかを決定し、メインページの目次を表示します（例：https://developer.android.com/referenceと同様）。G
# ENERATE_TREEVIEWが NO に設定されている場合、このオプションは効果がありません。
# デフォルト値は YES です。
# このタグはタグ GENERATE_HTML を YES に設定する必要があります。

PAGE_OUTLINE_PANEL     = YES

# GENERATE_TREEVIEWが YES に設定されている場合、 FULL_SIDEBAR
# オプションは、サイドバーがツリービューエリアのみに制限されるか（値 NO ）、ウィンドウの全高に拡張されるか（値 YES ）を決定します。これを YES に
# 設定すると、例えばhttps://docs.readthedocs.ioに似たレイアウトになり、コンテンツのためのスペースが増えますが、プロジェクトロゴ、タ
# イトル、説明のためのスペースが減ります。GENERATE_TREEVIEWが NO に設定されている場合、このオプションは効果がありません。
# デフォルト値は NO です。
# このタグはタグ GENERATE_HTML を YES に設定する必要があります。

FULL_SIDEBAR           = NO

# ENUM_VALUES_PER_LINE タグを使用して、生成されたHTMLドキュメントでDoxygenが1行にグループ化する列挙値の数を設定できます。
#
# 値が0の場合、概要セクションから列挙値が完全に抑制されることに注意してください。
# 最小値: 0, 最大値: 20, デフォルト値: 4。
# このタグはタグ GENERATE_HTML を YES に設定する必要があります。

ENUM_VALUES_PER_LINE   = 4

# SHOW_ENUM_VALUES タグが設定されている場合、Doxygenは列挙ニーモニックの横に列挙値を表示します。
# デフォルト値は NO です。

SHOW_ENUM_VALUES       = NO

# ツリービューが有効になっている場合（GENERATE_TREEVIEWを参照）、このタグを使用して、ツリーが表示されるフレームの初期幅（ピクセル単位）を設定
# できます。
# 最小値: 0, 最大値: 1500, デフォルト値: 250。
# このタグはタグ GENERATE_HTML を YES に設定する必要があります。

TREEVIEW_WIDTH         = 250

# EXT_LINKS_IN_WINDOW オプションが YES
# に設定されている場合、Doxygenはタグファイルを介してインポートされた外部シンボルへのリンクを別のウィンドウで開きます。
# デフォルト値は NO です。
# このタグはタグ GENERATE_HTML を YES に設定する必要があります。

EXT_LINKS_IN_WINDOW    = NO

# OBFUSCATE_EMAILS タグが YES に設定されている場合、Doxygenはメールアドレスを難読化します。
# デフォルト値は YES です。
# このタグはタグ GENERATE_HTML を YES に設定する必要があります。

OBFUSCATE_EMAILS       = YES

# HTML_FORMULA_FORMAT オプションが svg に設定されている場合、Doxygenはpdf2svgツール（https://github.c
# om/dawbarton/pdf2svgを参照）またはinkscape（https://inkscape.orgを参照）を使用して、HTML出力でPNGの代
# わりに数式をSVG画像として生成します。これらの画像は、拡大表示時により美しく見えます。
# 可能な値は:png (デフォルト)とsvg (より美しく表示されますが、pdf2svgまたはinkscapeツールが必要).
# デフォルト値は png です。
# このタグはタグ GENERATE_HTML を YES に設定する必要があります。

HTML_FORMULA_FORMAT    = png

# このタグを使用して、HTMLドキュメントに画像として埋め込まれるLaTeX数式のフォントサイズを変更します。Doxygenの実行が成功した後にフォントサイズ
# を変更する場合は、再生成を強制するためにHTML出力ディレクトリからすべてのform_*.png画像を手動で削除する必要があります。
# 最小値: 8, 最大値: 50, デフォルト値: 10。
# このタグはタグ GENERATE_HTML を YES に設定する必要があります。

FORMULA_FONTSIZE       = 10

# FORMULA_MACROFILE には、数式の構成要素として使用する新しいLaTeXコマンドを作成するためのLaTeX
# \newcommandおよび\renewcommandコマンドを記述できます。詳細については、セクション"Including formulas"
# を参照してください。

FORMULA_MACROFILE      =

# USE_MATHJAX オプションを有効にすると、事前レンダリングされたビットマップの代わりに、クライアント側JavaScriptでレンダリングを行うMa
# thJax（https://www.mathjax.orgを参照）を使用してLaTeX数式をレンダリングします。LaTeXがインストールされていない場合、ま
# たはHTML出力で数式をより美しく表示したい場合に使用します。有効にした場合、MathJaxを別途インストールし、MATHJAX_RELPATHオプションで
# パスを設定する必要がある場合もあります。
# デフォルト値は NO です。
# このタグはタグ GENERATE_HTML を YES に設定する必要があります。

USE_MATHJAX            = NO

# MATHJAX_VERSION を使用すると、使用するMathJaxのバージョンを指定できます。なお、MathJaxのバージョンによって設定要件が異なるた
# め、バージョンを切り替える際には他のMathJax設定も変更が必要になる場合があります。
# 可能な値は:MathJax_2, MathJax_3とMathJax_4.
# デフォルト値は MathJax_2 です。
# このタグはタグ USE_MATHJAX を YES に設定する必要があります。

MATHJAX_VERSION        = MathJax_2

# MathJaxが有効になっている場合、MathJax出力に使用されるデフォルトの出力形式を設定できます。出力形式の詳細については、MathJaxバージョン2
# (see:
# https://docs.mathjax.org/en/v2.7/output.html)、MathJaxバージョン3 (see:
# https://docs.mathjax.org/en/v3.2/output/index.html)、およびMathJaxバージョン4 (see:
# https://docs.mathjax.org/en/v4.0/output/index.htm)を参照してください。
# 可能な値は:HTML-CSS (より遅いですが、最高の互換性があります。これはMathJaxバージョン2の名称で、MathJaxバージョン3では chtml
# に変換されます), NativeMML (MathML。MathJax 2のみサポート。MathJaxバージョン3では chtml
# が代わりに使用されます。), chtml (これはMathJaxバージョン3の名称で、MathJaxバージョン2ではHTML-
# CSSに変換されます)とSVG.
# デフォルト値は HTML-CSS です。
# このタグはタグ USE_MATHJAX を YES に設定する必要があります。

MATHJAX_FORMAT         = HTML-CSS

# MathJaxが有効な場合、 MATHJAX_RELPATH オプションを使用してHTML出力ディレクトリからの
# 相対パスを指定する必要があります。MathJaxバージョン2の場合、宛先ディレクトリには
# MathJax.jsスクリプトが含まれている必要があります。例えば、 mathjax ディレクトリが HTML出力ディレクトリと同じレベルにある場合、
# MATHJAX_RELPATH は../mathjax である必要があります。MathJaxバージョン3および4の場合、宛先ディレクトリには
# tex-<format>.jsスクリプト（<format>はchtmlまたはsvg）が含まれている必要があります。
# デフォルト値はMathJaxコンテンツ配信ネットワークを指しているため、MathJaxをインストール
# せずに結果をすぐに確認できます。ただし、デプロイ前にhttps://www.mathjax.orgから
# MathJaxのローカルコピーをインストールすることを強くお勧めします。 デフォルト値は：
# - MathJaxバージョン2の場合: https://cdn.jsdelivr.net/npm/mathjax@2
# - MathJaxバージョン3の場合: https://cdn.jsdelivr.net/npm/mathjax@3
# - MathJaxバージョン4の場合: https://cdn.jsdelivr.net/npm/mathjax@4
# このタグはタグ USE_MATHJAX を YES に設定する必要があります。

MATHJAX_RELPATH        =

# MATHJAX_EXTENSIONS タグを使用して、MathJaxレンダリング中に有効にする1つ以上のMathJax拡張機能名を指定できます。例：Mat
# hJaxバージョン2（https://docs.mathjax.org/en/v2.7/tex.htmlを参照）：
# MATHJAX_EXTENSIONS = TeX/AMSmath TeX/AMSsymbols
# 例：MathJaxバージョン3（https://docs.mathjax.org/en/v3.2/input/tex/extensions/を参照）：
# MATHJAX_EXTENSIONS = ams
# 例：MathJaxバージョン4（https://docs.mathjax.org/en/v4.0/input/tex/extensions/を参照）：
# MATHJAX_EXTENSIONS = units
# Mathjaxバージョン4では、かなり多くの拡張機能がすでに自動的にロードされていることに注意してください。Mathjaxバージョン4でパッケージを無効に
# するには、マイナス記号を前に付けたパッケージ名を使用できます（-、例：MATHJAX_EXTENSIONS += -textmacros）
# このタグはタグ USE_MATHJAX を YES に設定する必要があります。

MATHJAX_EXTENSIONS     =

# MATHJAX_CODEFILE タグを使用して、MathJaxコードの起動時に使用されるJavaScriptコードを含むファイルを指定できます。詳細につ
# いては、MathJaxサイトを参照してください
# - MathJaxバージョン2 (see:
# https://docs.mathjax.org/en/v2.7/)
# - MathJaxバージョン3 (see:
# https://docs.mathjax.org/en/v3.2/)
# - MathJaxバージョン4 (see:
# https://docs.mathjax.org/en/v4.0/)例についてはドキュメントを参照してください。
# このタグはタグ USE_MATHJAX を YES に設定する必要があります。

MATHJAX_CODEFILE       =

# SEARCHENGINE タグが有効な場合、DoxygenはHTML出力の検索ボックスを生成します。基礎となる検索エンジンはJavaScriptとDHTM
# Lを使用し、最新のブラウザで動作するはずです。HTMLヘルプ（GENERATE_HTMLHELP）、Qtヘルプ（GENERATE_QHP）、またはdocse
# ts（GENERATE_DOCSET）を使用している場合、検索機能はすでに存在するため、これは通常無効にする必要があることに注意してください。大規模なプロジ
# ェクトでは、JavaScriptベースの検索エンジンは遅くなる可能性があるため、SERVER_BASED_SEARCHを有効にすると、より良いソリューション
# が提供される場合があります。キーボードを使用して検索できます。検索ボックスにジャンプするには、<アクセスキー> + Sを使用します（<アクセスキー>が何であ
# るかはOSとブラウザに依存しますが、通常は<CTRL>、<ALT>/<option>、またはその両方です）。検索ボックス内で、<下カーソルキー>を使用して検
# 索結果ウィンドウにジャンプし、<カーソルキー>を使用して結果をナビゲートできます。<Enter>を押して項目を選択するか、<Esc>を押して検索をキャンセル
# します。カーソルが検索ボックス内にあるときに<Shift>+<下カーソル>を押すと、フィルターオプションを選択できます。ここでも、<カーソルキー>を使用して
# フィルターを選択し、<Enter>または<Esc>を押してフィルターオプションをアクティブまたはキャンセルします。
# デフォルト値は YES です。
# このタグはタグ GENERATE_HTML を YES に設定する必要があります。

SEARCHENGINE           = YES

# SERVER_BASED_SEARCH タグが有効な場合、検索エンジンはJavaScriptを使用するWebクライアントではなくWebサーバーを使用して実
