# このタグはタグ GENERATE_RTF を YES に設定する必要があります。

COMPACT_RTF            = NO

# RTF_HYPERLINKS タグが YES に設定されている場合、生成されたRTFにはハイパーリンクフィールドが含まれます。RTFファイルには、ページ参
