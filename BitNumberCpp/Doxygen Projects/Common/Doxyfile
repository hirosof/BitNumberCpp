#
# Doxygenには、オープンソース検索エンジンライブラリXapian (see:
# https://xapian.org/)に基づいたサンプルインデクサー（ doxyindexer
# ）と検索エンジン（doxysearch.cgi）が付属しています。詳細については、セクション"External Indexing and
# Searching" を参照してください。
# このタグはタグ SEARCHENGINE を YES に設定する必要があります。

SEARCHENGINE_URL       =

# SERVER_BASED_SEARCHとEXTERNAL_SEARCHの両方が有効な場合、未インデックスの検索データが外部ツールでのインデックス作成用にファ
# イルに書き込まれます。 SEARCHDATA_FILE タグでこのファイルの名前を指定できます。
# デフォルトのファイルは searchdata.xml です。
# このタグはタグ SEARCHENGINE を YES に設定する必要があります。

SEARCHDATA_FILE        = searchdata.xml

# SERVER_BASED_SEARCHとEXTERNAL_SEARCHの両方が有効な場合、 EXTERNAL_SEARCH_ID タグをプロジェクトの識別子
