# デフォルト値は NO です。

GENERATE_AUTOGEN_DEF   = NO

#---------------------------------------------------------------------------
# Sqlite3出力に関連する設定オプション
#---------------------------------------------------------------------------

# GENERATE_SQLITE 3タグが YES に設定されている場合、DoxygenはDoxygenによって発見されたシンボルをテーブルに保存した
# Sqlite 3データベースを生成します。
# デフォルト値は NO です。

GENERATE_SQLITE3       = NO

# SQLITE 3_OUTPUTタグは、 Sqlite
# 3データベースが配置される場所を指定するために使用されます。相対パスが入力された場合、OUTPUT_DIRECTORYの値がその前に配置されます。
# デフォルトのディレクトリは sqlite3 です。
# このタグはタグ GENERATE_SQLITE3 を YES に設定する必要があります。

SQLITE3_OUTPUT         = sqlite3

# SQLITE 3_RECREATE_DBタグが YES
# に設定されている場合、既存のdoxygen_sqlite3.dbデータベースファイルはDoxygenを実行するたびに再作成されます。 NO
# に設定されている場合、Doxygenはデータベースファイルがすでに存在する場合は警告を出し、変更しません。
# デフォルト値は YES です。
# このタグはタグ GENERATE_SQLITE3 を YES に設定する必要があります。

SQLITE3_RECREATE_DB    = YES

#---------------------------------------------------------------------------
# Perlモジュール出力に関連する設定オプション
#---------------------------------------------------------------------------

# GENERATE_PERLMOD タグが YES
# に設定されている場合、Doxygenはすべてのドキュメントを含むコードの構造を記録したPerlモジュールファイルを生成します。
#
# なお、この機能はまだ実験的であり、現時点では不完全です。
# デフォルト値は NO です。

GENERATE_PERLMOD       = NO

# PERLMOD_LATEX タグが YES に設定されている場合、Doxygenは必要な Makefile ルール、 Perl
# スクリプト、およびLaTeXコードを生成し、Perlモジュール出力からPDFおよびDVI出力を生成できるようにします。
# デフォルト値は NO です。
# このタグはタグ GENERATE_PERLMOD を YES に設定する必要があります。

PERLMOD_LATEX          = NO

# PERLMOD_PRETTY タグが YES に設定されている場合、Perlモジュール出力は人間が読みやすいようにきれいにフォーマットされます。これは内部
# の動作を理解したい場合に便利です。一方、このタグが NO
# に設定されている場合、Perlモジュール出力のサイズははるかに小さくなりますが、Perlは同様に解析できます。
# デフォルト値は YES です。
# このタグはタグ GENERATE_PERLMOD を YES に設定する必要があります。

PERLMOD_PRETTY         = YES

# 生成されたdoxyrules.makeファイルのmake変数名には、 PERLMOD_MAKEVAR_PREFIX に含まれる文字列が先頭に付加されます。こ
# れは、同じMakefileにインクルードされる異なるdoxyrules.makeファイルが互いの変数を上書きしないようにするのに役立ちます。
# このタグはタグ GENERATE_PERLMOD を YES に設定する必要があります。

PERLMOD_MAKEVAR_PREFIX =

#---------------------------------------------------------------------------
# プリプロセッサに関連する設定オプション
#---------------------------------------------------------------------------

# ENABLE_PREPROCESSING タグが YES
# に設定されている場合、Doxygenはソースおよびインクルードファイルで見つかったすべてのCプリプロセッサディレクティブを評価します。
# デフォルト値は YES です。

ENABLE_PREPROCESSING   = YES

# MACRO_EXPANSION タグが YES に設定されている場合、Doxygenはソースコード内のすべてのマクロ名を展開します。 NO
# に設定されている場合、条件付きコンパイルのみが実行されます。マクロ展開は、EXPAND_ONLY_PREDEFを YES
# に設定することで制御された方法で行うことができます。
# デフォルト値は NO です。
# このタグはタグ ENABLE_PREPROCESSING を YES に設定する必要があります。

MACRO_EXPANSION        = NO

# EXPAND_ONLY_PREDEF およびMACRO_EXPANSIONタグの両方が YES
# に設定されている場合、マクロ展開はPREDEFINEDおよびEXPAND_AS_DEFINEDタグで指定されたマクロに制限されます。
# デフォルト値は NO です。
# このタグはタグ ENABLE_PREPROCESSING を YES に設定する必要があります。

EXPAND_ONLY_PREDEF     = NO

# SEARCH_INCLUDES タグが YES に設定されている場合、 #include
# が見つかった場合、INCLUDE_PATH内のインクルードファイルが検索されます。
# デフォルト値は YES です。
# このタグはタグ ENABLE_PREPROCESSING を YES に設定する必要があります。

SEARCH_INCLUDES        = YES

# INCLUDE_PATH
# タグを使用して、入力ファイルではないがプリプロセッサによって処理する必要があるインクルードファイルを含む1つ以上のディレクトリを指定できます。
# INCLUDE_PATH は再帰的ではないため、RECURSIVEの設定はここでは効果がないことに注意してください。
# このタグはタグ SEARCH_INCLUDES を YES に設定する必要があります。

INCLUDE_PATH           =

# INCLUDE_FILE_PATTERNS タグを使用して、ディレクトリ内のヘッダーファイルをフィルタリングする1つ以上のワイルドカードパターン（*.hや
# *.hppのように）を指定できます。空白のままにすると、FILE_PATTERNSで指定されたパターンが使用されます。
# このタグはタグ ENABLE_PREPROCESSING を YES に設定する必要があります。

INCLUDE_FILE_PATTERNS  =

# PREDEFINED タグを使用して、プリプロセッサが起動する前に定義される1つ以上のマクロ名を指定できます（例： gcc
# の-Dオプションと同様）。タグの引数は、nameまたはname=definitionの形式のマクロのリストです（スペースなし）。定義と =
# が省略された場合、 =1 が仮定されます。マクロ定義が #undef を介して未定義にされたり、再帰的に展開されたりするのを防ぐには、 =
# 演算子の代わりに:=演算子を使用します。
# このタグはタグ ENABLE_PREPROCESSING を YES に設定する必要があります。

PREDEFINED             =

# MACRO_EXPANSIONおよびEXPAND_ONLY_PREDEFタグが YES に設定されている場合、このタグを使用して展開するマクロ名のリストを指
# 定できます。ソースで見つかったマクロ定義が使用されます。ソースコードで見つかった定義をオーバーライドする異なるマクロ定義を使用する場合は、PREDEFINE
# Dタグを使用します。
# このタグはタグ ENABLE_PREPROCESSING を YES に設定する必要があります。

EXPAND_AS_DEFINED      =

# SKIP_FUNCTION_MACROS タグが YES に設定されている場合、Doxygenのプリプロセッサは、単独行にある、すべて大文字の名前を持ち、
# セミコロンで終わらない関数マクロへのすべての参照を削除します。このような関数マクロは通常ボイラープレートコードに使用され、削除されないとパーサーを混乱させま
# す。
# デフォルト値は YES です。
# このタグはタグ ENABLE_PREPROCESSING を YES に設定する必要があります。

SKIP_FUNCTION_MACROS   = YES

#---------------------------------------------------------------------------
# 外部参照に関連する設定オプション
#---------------------------------------------------------------------------

# TAGFILES タグを使用して、1つ以上のタグファイルを指定できます。各タグファイルについて、外部ドキュメントの場所を追加する必要があります。場所なしの
# タグファイルの形式は次のとおりです：
# TAGFILES = file1 file2 ...
# タグファイルの場所の追加は次のように行います：
# TAGFILES = file1=loc1 "file2 = loc2" ...
# ここでloc1とloc2は相対パス、絶対パス、またはURLにすることができます。タグファイルの使用の詳細については、セクション"Linking to
# external documentation" を参照してください。
# 注: 各タグファイルは一意の名前を持つ必要があります（名前にはパスを含みません）。タグファイルがDoxygenを実行するディレクトリにない場合は、ここでタグ
# ファイルへのパスも指定する必要があります。

TAGFILES               =

# GENERATE_TAGFILE の後にファイル名が指定されると、Doxygenは読み取った入力ファイルに基づいてタグファイルを作成します。タグファイルの
# 使用の詳細については、セクション"Linking to external documentation" を参照してください。

GENERATE_TAGFILE       =

# ALLEXTERNALS タグが YES に設定されている場合、すべての外部クラスと名前空間がクラスおよび名前空間インデックスにリストされます。 NO
# に設定されている場合、継承された外部クラスのみがリストされます。
# デフォルト値は NO です。

ALLEXTERNALS           = NO

# EXTERNAL_GROUPS タグが YES に設定されている場合、すべての外部グループがトピックインデックスにリストされます。 NO
# に設定されている場合、現在のプロジェクトのグループのみがリストされます。
# デフォルト値は YES です。

EXTERNAL_GROUPS        = YES

# EXTERNAL_PAGES タグが YES に設定されている場合、すべての外部ページが関連ページインデックスにリストされます。 NO
# に設定されている場合、現在のプロジェクトのページのみがリストされます。
# デフォルト値は YES です。

EXTERNAL_PAGES         = YES

#---------------------------------------------------------------------------
# ダイアグラム生成ツールに関連する設定オプション
#---------------------------------------------------------------------------

# HIDE_UNDOC_RELATIONS タグが YES
# に設定されている場合、継承およびコラボレーショングラフは、ターゲットが未文書化であるかクラスでない場合、継承および使用関係を非表示にします。
# デフォルト値は YES です。

HIDE_UNDOC_RELATIONS   = YES

# HAVE_DOT タグを YES に設定すると、Doxygenは path から dot
# ツールが利用可能であると仮定します。このツールはAT&TおよびLucent Bell LabsのGraphviz (see:
# https://www.graphviz.org/)グラフ可視化ツールキットの一部です。このオプションが NO
# に設定されている場合、このセクションの他のオプションは効果がありません。
# デフォルト値は NO です。

HAVE_DOT               = YES

# DOT_NUM_THREADS は、Doxygenが並列で実行できる dot 呼び出しの数を指定します。 0 に設定すると、Doxygenはシステムで利用
# 可能なプロセッサの数に基づいて決定します。CPU負荷と処理速度のバランスを制御するために、0より大きい値を明示的に設定できます。
# 最小値: 0, 最大値: 512, デフォルト値: 0。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

DOT_NUM_THREADS        = 0

# DOT_BATCH_SIZE は、Doxygen が1回の dot 呼び出しでコンパイルできる dot グラフの数を指定します。 1
# に設定すると、Doxygen は各グラフに対して個別に dot を呼び出しますが、特に多くの CPU コアを
# 持つシステムでは、プロセス作成のオーバーヘッドが大きくなる可能性があります。 DOT_NUM_THREADS と
# 共にこの設定を使用することで、特定のシステムの dot 処理速度を最適化できます。Doxygen は各スレッドに
# バランスの取れた作業量を割り当てようとします。処理するグラフの総数が DOT_NUM_THREADS * DOT_BATCH_SIZE を超える場合、
# dot が処理するための追加バッチが作成されます。
# 最小値: 1, 最大値: 1000, デフォルト値: 50。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

DOT_BATCH_SIZE         = 50

# DOT_COMMON_ATTR は、ノード、エッジ、およびサブグラフラベルの共通属性です。Doxygenが生成するdotファイルで異なる外観のフォントを使
# 用したい場合、fontname、fontcolor、およびfontsize属性を指定できます。詳細については、<a href=https://graphvi
# z.org/doc/info/attrs.html>ノード、エッジ、およびグラフ属性の仕様</a>を参照してください。 dot
# がフォントを見つけられることを確認する必要があります。これは、標準の場所に配置するか、 DOTFONTPATH
# 環境変数を設定するか、フォントを含むディレクトリにDOT_FONTPATHを設定することで行います。デフォルトのgraphvizフォントサイズは14です。
# デフォルト値は fontname=Helvetica,fontsize=10 です。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

DOT_COMMON_ATTR        = "fontname=Helvetica,fontsize=10"

# DOT_EDGE_ATTR はDOT_COMMON_ATTRと連結されます。エレガントなスタイルにするには、'arrowhead=open,
# arrowtail=open, arrowsize=0.5'を追加できます。<a
# href=https://graphviz.org/doc/info/arrows.html>矢印形状の完全なドキュメント</a>
# デフォルト値は labelfontname=Helvetica,labelfontsize=10 です。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

DOT_EDGE_ATTR          = "labelfontname=Helvetica,labelfontsize=10"

# DOT_NODE_ATTR はDOT_COMMON_ATTRと連結されます。ノードの周りのボックスなしの表示には、'shape=plain'または'sha
# pe=plaintext'を設定します。<a
# href=https://www.graphviz.org/doc/info/shapes.html>形状の仕様</a>
# デフォルト値は shape=box,height=0.2,width=0.4 です。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

DOT_NODE_ATTR          = "shape=box,height=0.2,width=0.4"

# DOT_COMMON_ATTRおよび他のdot属性でfontnameにより指定されたフォントを dot が見つけられるパスを設定できます。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

DOT_FONTPATH           =

# CLASS_GRAPH タグが YES または GRAPH または BUILTIN
# に設定されている場合、Doxygenは文書化された各クラスのグラフを生成し、直接および間接の継承関係を示します。 CLASS_GRAPH タグが YES
# または GRAPH に設定され、HAVE_DOTも有効な場合、dotがグラフの描画に使用されます。 CLASS_GRAPH タグが YES
# に設定され、HAVE_DOTが無効な場合、または CLASS_GRAPH タグが BUILTIN
# に設定されている場合、組み込みジェネレーターが使用されます。 CLASS_GRAPH タグが TEXT に設定されている場合、直接および間接の継承関係がテキ
# スト/リンクとして表示されます。特定のクラスの継承グラフを明示的に有効にするか、異なる表現を選択するには、\inheritancegraphコマンドを使用で
# きます。継承グラフを無効にするには、\hideinheritancegraphコマンドを使用できます。
# 可能な値は:NO, YES, TEXT, GRAPHとBUILTIN.
# デフォルト値は YES です。

CLASS_GRAPH            = YES

# COLLABORATION_GRAPH タグが YES に設定されている場合、Doxygenは文書化された各クラスのグラフを生成し、クラスと他の文書化され
# たクラスとの直接および間接の実装依存関係（継承、包含、およびクラス参照変数）を示します。 COLLABORATION_GRAPH が NO に設定されている
# 場合、コラボレーショングラフを明示的に有効にするには、\collaborationgraphコマンドを使用できます。コラボレーショングラフを無効にするには、
# \hidecollaborationgraphコマンドを使用できます。
# デフォルト値は YES です。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

COLLABORATION_GRAPH    = YES

# GROUP_GRAPHS タグが YES に設定されている場合、Doxygenはグループのグラフを生成し、グループの直接の依存関係を示します。
# GROUP_GRAPHS が NO に設定されている場合でも、グループ依存グラフを明示的に有効にするには、\groupgraphコマンドを使用できます。グル
# ープグラフを無効にするには、\hidegroupgraphコマンドを使用できます。マニュアルのグループ化の章も参照してください。
# デフォルト値は YES です。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

GROUP_GRAPHS           = YES

# UML_LOOK タグが YES
# に設定されている場合、DoxygenはOMGの統一モデリング言語（UML）と同様のスタイルで継承およびコラボレーションダイアグラムを生成します。
# デフォルト値は NO です。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

UML_LOOK               = NO

# UML_LOOKタグが有効な場合、フィールドとメソッドはクラスノード内に表示されます。多くのフィールドやメソッドと多くのノードがある場合、グラフは有用でない
# ほど大きくなる可能性があります。 UML_LIMIT_NUM_FIELDS しきい値は、サイズをより管理しやすくするために各タイプのアイテム数を制限します。
# 制限なしの場合は0に設定します。なお、しきい値は制限が適用される前に50%まで超過する可能性があります。したがって、しきい値を10に設定すると、最大15フィ
# ールドが表示される可能性がありますが、数が15を超えると、表示されるフィールドの総数は10に制限されます。
# 最小値: 0, 最大値: 100, デフォルト値: 10。
# このタグはタグ UML_LOOK を YES に設定する必要があります。

UML_LIMIT_NUM_FIELDS   = 10

# UML_LOOKタグが有効な場合、フィールドラベルは2つのクラスノード間のエッジに沿って表示されます。多くのフィールドと多くのノードがある場合、グラフは雑然
# としすぎる可能性があります。 UML_MAX_EDGE_LABELS
# しきい値は、サイズをより管理しやすくするためにアイテム数を制限します。制限なしの場合は0に設定します。
# 最小値: 0, 最大値: 100, デフォルト値: 10。
# このタグはタグ UML_LOOK を YES に設定する必要があります。

UML_MAX_EDGE_LABELS    = 10

# DOT_UML_DETAILS タグが NO に設定されている場合、DoxygenはUMLグラフでタイプと引数なしで属性とメソッドを表示します。
# DOT_UML_DETAILS タグが YES に設定されている場合、DoxygenはUMLグラフで属性とメソッドのタイプと引数を追加します。
# DOT_UML_DETAILS タグが NONE に設定されている場合、DoxygenはUMLグラフでクラスメンバー情報を持つフィールドを生成しません。クラ
# ス図はデフォルトのクラス図に似ていますが、関係にUML表記を使用します。
# 可能な値は:NO, YESとNONE.
# デフォルト値は NO です。
# このタグはタグ UML_LOOK を YES に設定する必要があります。

DOT_UML_DETAILS        = NO

# DOT_WRAP_THRESHOLD タグを使用して、1行に表示される最大文字数を設定できます。実際の行の長さがこのしきい値を大幅に超える場合、複数行に分
# 割されます。見苦しい改行を避けるためにいくつかのヒューリスティックが適用されます。
# 最小値: 0, 最大値: 1000, デフォルト値: 17。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

DOT_WRAP_THRESHOLD     = 17

# TEMPLATE_RELATIONS タグが YES
# に設定されている場合、継承およびコラボレーショングラフはテンプレートとそのインスタンス間の関係を示します。
# デフォルト値は NO です。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

TEMPLATE_RELATIONS     = NO

# INCLUDE_GRAPH 、ENABLE_PREPROCESSING、およびSEARCH_INCLUDESタグがすべて YES に設定されている場合、D
# oxygenは文書化された各ファイルのグラフを生成し、ファイルと他の文書化されたファイルとの直接および間接のインクルード依存関係を示します。
# INCLUDE_GRAPH が NO に設定されている場合、インクルードグラフを明示的に有効にするには、\includegraphコマンドを使用できます。イ
# ンクルードグラフを無効にするには、\hideincludegraphコマンドを使用できます。
# デフォルト値は YES です。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

INCLUDE_GRAPH          = YES

# INCLUDED_BY_GRAPH 、ENABLE_PREPROCESSING、およびSEARCH_INCLUDESタグがすべて YES に設定されている
# 場合、Doxygenは文書化された各ファイルのグラフを生成し、ファイルと他の文書化されたファイルとの直接および間接のインクルード依存関係を示します。
# INCLUDED_BY_GRAPH が NO に設定されている場合、インクルード元グラフを明示的に有効にするには、\includedbygraphコマンドを
# 使用できます。インクルード元グラフを無効にするには、\hideincludedbygraphコマンドを使用できます。
# デフォルト値は YES です。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

INCLUDED_BY_GRAPH      = YES

# CALL_GRAPH タグが YES に設定されている場合、Doxygenは各グローバル関数またはクラスメソッドの呼び出し依存グラフを生成します。
#
# このオプションを有効にすると実行時間が大幅に増加することに注意してください。したがって、ほとんどの場合、\callgraphコマンドを使用して選択した関数の
# 呼び出しグラフのみを有効にする方が良いでしょう。呼び出しグラフを無効にするには、\hidecallgraphコマンドを使用できます。
# デフォルト値は NO です。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

CALL_GRAPH             = NO

# CALLER_GRAPH タグが YES に設定されている場合、Doxygenは各グローバル関数またはクラスメソッドの呼び出し元依存グラフを生成します。
#
# このオプションを有効にすると実行時間が大幅に増加することに注意してください。したがって、ほとんどの場合、\callergraphコマンドを使用して選択した関
# 数の呼び出し元グラフのみを有効にする方が良いでしょう。呼び出し元グラフを無効にするには、\hidecallergraphコマンドを使用できます。
# デフォルト値は NO です。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

CALLER_GRAPH           = NO

# GRAPHICAL_HIERARCHY タグが YES
# に設定されている場合、Doxygenはテキストの代わりにすべてのクラスのグラフィカルな階層図を生成します。
# デフォルト値は YES です。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

GRAPHICAL_HIERARCHY    = YES

# DIRECTORY_GRAPH タグが YES
# に設定されている場合、Doxygenはディレクトリの他のディレクトリへの依存関係をグラフィカルに示します。依存関係は、ディレクトリ内のファイル間の
# #include 関係によって決定されます。 DIRECTORY_GRAPH が NO に設定されている場合、ディレクトリグラフを明示的に有効にするには、\
# directorygraphコマンドを使用できます。ディレクトリグラフを無効にするには、\hidedirectorygraphコマンドを使用できます。
# デフォルト値は YES です。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

DIRECTORY_GRAPH        = YES

# DIR_GRAPH_MAX_DEPTH タグを使用して、 dot によってディレクトリ依存グラフで生成される子ディレクトリレベルの最大数を制限できます。
# 最小値: 1, 最大値: 25, デフォルト値: 1。
# このタグはタグ DIRECTORY_GRAPH を YES に設定する必要があります。

DIR_GRAPH_MAX_DEPTH    = 1

# DOT_IMAGE_FORMAT タグを使用して、 dot によって生成される画像の形式を設定できます。画像形式の説明については、 dot
# ツールのドキュメントの出力形式セクションを参照してください（Graphviz (see:
# https://www.graphviz.org/)）。
#
# なお、svg:cairoおよびsvg:cairo:cairo形式はINTERACTIVE_SVGと組み合わせて使用できません（INTERACTIVE_SVG
# はNOに設定されます）。
# 可能な値は:png, jpg, gif, svg, png:gd, png:gd:gd, png:cairo, png:cairo:gd,
# png:cairo:cairo, png:cairo:gdiplus, png:gdiplus, png:gdiplus:gdiplus,
# svg:cairo, svg:cairo:cairo, svg:svg, svg:svg:core, gif:cairo, gif:cairo:gd,
# gif:cairo:gdiplus, gif:gdiplus, gif:gdiplus:gdiplus, gif:gd, gif:gd:gd,
# jpg:cairo, jpg:cairo:gd, jpg:cairo:gdiplus, jpg:gd, jpg:gd:gd,
# jpg:gdiplusとjpg:gdiplus:gdiplus.
# デフォルト値は png です。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

DOT_IMAGE_FORMAT       = png

# DOT_IMAGE_FORMATがsvgまたはsvg:svgまたはsvg:svg:coreに設定されている場合、このオプションを YES
# に設定して、ズームとパンを可能にするインタラクティブSVG画像の生成を有効にできます。
#
# なお、Internet Explorer以外の最新のブラウザが必要です。テスト済みで動作するもの：Firefox、Chrome、Safari、Opera。
#
# DOT_IMAGE_FORMATがsvg:cairoまたはsvg:cairo:cairoに設定されている場合、このオプションは自動的に無効になります。
# デフォルト値は NO です。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

INTERACTIVE_SVG        = NO

# DOT_PATH タグを使用して、 dot ツールが見つかるパスを指定できます。空白のままにすると、 dot ツールが path
# で見つかると仮定されます。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

DOT_PATH               =

# DOTFILE_DIRS
# タグを使用して、ドキュメントにインクルードされるdotファイルを含む1つ以上のディレクトリを指定できます（\dotfileコマンドを参照）。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

DOTFILE_DIRS           =

# Doxygenドキュメントにdiaで作成したダイアグラムを含めることができます。Doxygenはdiaを実行してダイアグラムを生成し、ドキュメントに挿入しま
# す。 DIA_PATH
# タグを使用すると、diaバイナリが存在するディレクトリを指定できます。空白のままにすると、diaはデフォルトの検索パスで見つかると仮定されます。

DIA_PATH               =

# DIAFILE_DIRS
# タグを使用して、ドキュメントにインクルードされるdiaファイルを含む1つ以上のディレクトリを指定できます（\diafileコマンドを参照）。

DIAFILE_DIRS           =

# PlantUMLを使用する場合、 PLANTUML_JAR_PATH タグを使用して、javaが plantuml
# .jarファイルを見つけられるパス、または使用する jar ファイルのファイル名を指定する必要があります。空白のままにすると、PlantUMLは使用されない
# か、前処理ステップで呼び出されると仮定されます。この場合、Doxygenは\startumlコマンドに遭遇すると警告を生成し、ダイアグラムの出力を生成しませ
# ん。

PLANTUML_JAR_PATH      =

# PlantUMLを使用する場合、 PLANTUML_CFG_FILE タグを使用してPlantUMLの設定ファイルを指定できます。

PLANTUML_CFG_FILE      =

# PlantUMLを使用する場合、指定されたパスはPlantUMLブロック内の !include ステートメントで指定されたファイルに対して検索されます。

PLANTUML_INCLUDE_PATH  =

# PLANTUMLFILE_DIRS タグを使用して、ドキュメントにインクルードされるPlantUmlファイルを含む1つ以上のディレクトリを指定できます（\
# plantumlfileコマンドを参照）。

PLANTUMLFILE_DIRS      =

# CLIレンダリングでMermaidダイアグラムを使用する場合、 MERMAID_PATH タグを使用して、 mmdc （Mermaid CLI）実行可能ファ
# イルが見つかるディレクトリを指定する必要があります。空白のままにすると、CLIベースのレンダリングは無効になります。HTML出力の場合、JavaScript
# によるクライアント側レンダリングがデフォルトで使用され、 mmdc は必要ありません。LaTeX/PDF出力の場合、画像を事前生成するために mmdc
# が必要です。CLIレンダリングが必要だが mmdc が利用できない場合、Doxygenは警告を生成します。

MERMAID_PATH           =

# Mermaidダイアグラムを使用する場合、 MERMAID_CONFIG_FILE タグを使用して、Mermaid CLIツール（ mmdc
# ）のJSON設定ファイルを指定できます。このファイルには、テーマ設定やその他のMermaid設定オプションを含めることができます。

MERMAID_CONFIG_FILE    =

# MERMAID_RENDER_MODE タグは、Mermaidダイアグラムのレンダリング方法を選択します。
# 可能な値は:AUTO (HTMLにはクライアント側レンダリングを使用し、LaTeX/PDFおよびその他の形式には mmdc を使用。
# MERMAID_PATH が設定されていない場合、非HTMLダイアグラムは警告を生成します), CLI (mmdc ツールを使用して画像を事前生成(Node
# .jsとmermaid-js/mermaid-cliが必要)。すべての出力形式で動作)とCLIENT_SIDE (クライアント側レンダリングのために
# mermaid.js をHTML出力に埋め込み。 mmdc は不要ですが、HTML出力でのみ動作).
# デフォルト値は AUTO です。

MERMAID_RENDER_MODE    = AUTO

# MERMAID_JS_URL タグは、クライアント側レンダリングを使用する場合（ MERMAID_RENDER_MODE が CLIENT_SIDE
# または AUTO ）に mermaid.js をロードするURLを指定します。デフォルトはjsDelivr CDNの最新のMermaid
# v11を指しています。
#
# デフォルトのCDN URLは、生成されたドキュメントを表示する際にインターネットアクセスが必要です。オフライン使用の場合は、
# mermaid.esm.min.mjs をダウンロードしてこれを相対パスに設定するか、代わりに MERMAID_RENDER_MODE
# =CLIを使用して画像を事前生成します。
# 例：
# -
# 最新のv11（デフォルト）：https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs
# - ピン留めされたバージョン：https://cdn.jsdelivr.net/npm/mermaid@11.3.0/dist/mermaid.esm.m
# in.mjs
# - ローカルコピー：./mermaid.esm.min.mjs（ユーザーはファイルをHTML出力ディレクトリに配置する必要があります）
# デフォルト値は https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs です。

MERMAID_JS_URL         = https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs

# MERMAIDFILE_DIRS
# タグを使用して、ドキュメントにインクルードされるMermaidファイルを含む1つ以上のディレクトリを指定できます（\mermaidfileコマンドを参照）。

MERMAIDFILE_DIRS       =

# DOT_GRAPH_MAX_NODES タグを使用して、グラフに表示されるノードの最大数を設定できます。グラフ内のノード数がこの値を超えると、Doxyge
# nはグラフを切り詰め、ノードを赤いボックスとして表示することで視覚化します。なお、グラフのルートノードの直接の子の数がすでに
# DOT_GRAPH_MAX_NODES
# を超えている場合、グラフは表示されません。また、グラフのサイズはMAX_DOT_GRAPH_DEPTHによってさらに制限される可能性があります。
# 最小値: 0, 最大値: 10000, デフォルト値: 50。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

DOT_GRAPH_MAX_NODES    = 50

# MAX_DOT_GRAPH_DEPTH タグを使用して、 dot によって生成されるグラフの最大深度を設定できます。深度値3は、最大3エッジを経由するパス
# でルートから到達可能なノードのみが表示されることを意味します。ルートノードからより遠いノードは省略されます。なお、このオプションを1または2に設定すると、大
# 規模なコードベースの計算時間を大幅に削減できます。また、グラフのサイズはDOT_GRAPH_MAX_NODESによってさらに制限される可能性があります。深度
# 0を使用すると、深度の制限はありません。
# 最小値: 0, 最大値: 1000, デフォルト値: 0。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

MAX_DOT_GRAPH_DEPTH    = 0

# GENERATE_LEGEND タグが YES
# に設定されている場合、Doxygenはdotによって生成されたグラフの様々なボックスと矢印の意味を説明する凡例ページを生成します。
# 注: このタグは、UML_LOOKが設定されていないことを前提としています。つまり、継承およびコラボレーションダイアグラムにDoxygenの内部グラフィカル
# 表現が使用される場合に有効です。
# デフォルト値は YES です。
# このタグはタグ HAVE_DOT を YES に設定する必要があります。

GENERATE_LEGEND        = YES

# DOT_CLEANUP タグが YES に設定されている場合、Doxygenは各種グラフを生成するために使用された中間ファイルを削除します。
#
# なお、この設定はdotファイルだけでなく、一時的なmscファイルにも適用されます。
# デフォルト値は YES です。

DOT_CLEANUP            = YES

# Doxygenコメント内で\mscコマンドを使用してメッセージシーケンスチャートを定義できます。 MSCGEN_TOOL
# タグが空白のまま（デフォルト）の場合、Doxygenはチャートを生成するために組み込みバージョンのmscgenツールを使用します。または、
# MSCGEN_TOOL タグで外部ツールの名前を指定することもできます。例えば、値としてprogを指定すると、Doxygenはツールをprog -T
# <outfile_format> -o <outputfile> <inputfile>として呼び出します。外部ツールは、出力ファイル形式「png」、「ep
# s」、「svg」、および「ismap」をサポートする必要があります。

MSCGEN_TOOL            =

# MSCFILE_DIRS
# タグを使用して、ドキュメントにインクルードされるmscファイルを含む1つ以上のディレクトリを指定できます（\mscfileコマンドを参照）。

MSCFILE_DIRS           =
