REFERENCES_LINK_SOURCE = YES

# SOURCE_TOOLTIPS が有効な場合（デフォルト）、ソースコード内のハイパーリンクにカーソルを合わせると、プロトタイプ、概要説明、定義およびドキュ
# メントへのリンクなどの追加情報を含むツールチップが表示されます。これによりHTMLファイルが大きくなり、大きなファイルの読み込みが少し遅くなるため、この機能
# を無効にすることもできます。
